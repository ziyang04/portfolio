{
  "name": "reachloop",
  "version": "0.1.0",
  "private": true,
  "description": "AI social-media growth agent: analyzes a company, targets audiences, generates and posts content via Claude Agent SDK subagents, and self-improves from reach.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "agent": "cd agent && uvicorn server:app --reload --port 8787",
    "dev:all": "concurrently -k -n web,agent -c blue,magenta \"npm run dev\" \"npm run agent\""
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "concurrently": "8.2.2",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.6",
    "typescript": "5.5.3"
  }
}
