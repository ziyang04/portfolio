# react-scripts 5 (Create React App) cannot handle pnpm's default symlinked
# node_modules: ESLint resolves eslint-config-react-app through two different
# paths and fails with `Plugin "react" was conflicted between ...`.
# A flat (npm-style) layout fixes it. Packages are still hardlinked from the
# pnpm store, so this costs no extra disk space.
node-linker=hoisted
