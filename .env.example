# ── Next.js (Node) ────────────────────────────────────────────────
# Where the Next.js API routes reach the Python Claude Agent SDK service.
AGENT_SERVICE_URL=http://localhost:8787

# ── Python agent service (agent/.env) ─────────────────────────────
# The Claude Agent SDK reads this. Without it, the service runs in a
# fully-functional MOCK mode so you can demo the whole flow offline.
ANTHROPIC_API_KEY=

# Model selection (optional — sensible defaults are baked in).
# Orchestrator/learning use the most capable model; content subagents
# use a faster one so the fan-out stays cheap.
ORCHESTRATOR_MODEL=claude-opus-4-8
CONTENT_MODEL=claude-sonnet-4-6
